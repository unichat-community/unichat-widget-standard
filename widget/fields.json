    },
    "cheerMessageWithValue": {
        "type": "text",
        "group": "Cheer",
        "label": "Label with value",
        "description": "Placeholders: {value}, {currency}, {cheerTitle}, {authorDisplayName}.",
        "value": "{value} {currency}"
    },
    "cheerMessageWithoutValue": {
        "type": "text",
        "group": "Cheer",
        "label": "Label without value",
        "description": "Placeholders: {cheerTitle}, {currency}, {authorDisplayName}.",
