    },

    "__raid": "<=============================================================>",

    "raidEnabled": {
        "type": "switch",
        "group": "Raid",
        "label": "Show raids",
        "value": true
    },
    "raidColor": {
        "type": "colorpicker",
        "group": "Raid",
