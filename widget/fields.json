    "__cheer": "<============================================================>",

    "cheerEnabled": {
        "type": "switch",
        "group": "Cheer",
        "label": "Show cheers",
        "value": true
    },
    "cheerMinValue": {
        "type": "number",
        "group": "Cheer",
        "label": "Minimum value",
        "description": "Below it, the cheer shows as a regular message. Cheers without value are always shown.",
        "value": 0,
        "min": 0,
        "step": 1
    },
    "cheerColor": {
        "type": "colorpicker",
        "group": "Cheer",
        "label": "Color",
        "value": "#ad8cff"
    },
    "cheerIcon": {
        "type": "text",
        "group": "Cheer",
        "label": "Icon",
        "description": "Font Awesome 5 classes.",
